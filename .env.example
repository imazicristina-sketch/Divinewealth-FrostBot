# Railway Variables: copy these names into Railway -> Variables.
MC_HOST=ry9.terohost.in
MC_PORT=25866
MC_VERSION=26.3
BOT_USERNAME=Divinewealth
# For an offline-mode server use offline. For online-mode, use microsoft
# and complete Microsoft authentication; do not share account passwords.
MC_AUTH=offline

# Comma-separated names Divinewealth must never attack.
TRUSTED_PLAYERS=Divinewealth,CatRexy
OWNER_NAME=CatRexy

# Set a long random secret here AND in the Paper plugin config.
GUARDIAN_TOKEN=change-this-to-a-long-random-secret
GUARDIAN_PORT=3000
ENABLE_GUARDIAN=true
